# Copier en .env et ajuster si besoin. Toutes les valeurs ont des défauts sensés.

SEO_DATABASE_PATH=data/processed/keywords.db
SEO_RAW_OUTPUT_DIR=data/raw
SEO_PROCESSED_OUTPUT_DIR=data/processed

# Délai entre requêtes réseau (secondes) — courtoisie envers les endpoints publics
SEO_REQUEST_DELAY_SECONDS=0.5
SEO_REQUEST_TIMEOUT_SECONDS=8.0
SEO_MAX_RETRIES=3

SEO_TRENDS_TIMEFRAME=today 5-y

# Google Ads API — les jetons développeur ont été supprimés le 09/09/2026,
# les niveaux d'accès sont désormais portés par le projet Google Cloud.
# Générer le refresh token (une seule fois, navigateur requis) :
#   uv run python scripts/google_ads_authorize.py <client_secret.json>
GOOGLE_ADS_USE_PROTO_PLUS=True
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Compte interrogé, sans tirets
GOOGLE_ADS_CUSTOMER_ID=
# Compte administrateur (MCC), sans tirets — seulement si le compte y est rattaché
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
